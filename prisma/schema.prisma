// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id                     Int           @id @default(autoincrement())
  discordId              String        @unique
  name                   String
  guildChannels          GuildChannel[]
  guildCurrencies        GuildCurrency[]
  guildRemovalReasons    GuildRemovalReason[]
  guildRoles             GuildRole[]
  aiRoleplayConfig       GuildAiRoleplayConfig?
  roleplaySessions       RoleplaySession[]
}

model GuildAiRoleplayConfig {
  guildId               Int     @id
  triggerEmoji          String
  systemPrompt          String  @db.Text
  buttonCost            Int
  authorRewardOnTrigger Int
  authorRewardOnChoice  Int
  thinkingMode          Boolean
  guild                 Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model RoleplaySession {
  id                String   @id @default(cuid())
  guildId           Int
  sourceMessageId   String
  sourceChannelId   String
  sourceAuthorId    String
  initiatorId       String
  sourceMessageUrl  String
  sourceCaption     String   @db.Text
  sourceImageUrl    String?
  outputMessageId   String?
  outputChannelId   String?
  pendingChoices    Json?
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  guild             Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  turns             RoleplayTurn[]
}

model RoleplayTurn {
  id        Int             @id @default(autoincrement())
  sessionId String
  role      String
  content   String          @db.Text
  session   RoleplaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}



model GuildChannel {
  id      Int    @id @default(autoincrement())
  guildId Int
  name    String
  discordId              String        @unique
  guild   Guild @relation(fields: [guildId], references: [id])
}

model GuildCurrency {
  id      Int    @id @default(autoincrement())
  guildId Int
  name    String
  namePlural    String 
  iconSrc String
  guild   Guild @relation(fields: [guildId], references: [id])
}

model GuildRemovalReason {
  id      Int    @id @default(autoincrement())
  guildId Int
  title   String
  description String
  value   String
  guild   Guild @relation(fields: [guildId], references: [id])
}

model GuildRole {
  id          Int     @id @default(autoincrement())
  guildId     Int
  name        String
  discordId   String  @unique
  imageLimit  Int?
  guild       Guild   @relation(fields: [guildId], references: [id])
}

model AppSetting {
  key   String @id
  value String
}