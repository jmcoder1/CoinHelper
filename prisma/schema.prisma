generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id                     Int           @id @default(autoincrement())
  discordId              String        @unique
  name                   String
  guildChannels          GuildChannel[]
  guildCurrencies        GuildCurrency[]
  guildRemovalReasons    GuildRemovalReason[]
  guildRoles             GuildRole[]
}



model GuildChannel {
  id      Int    @id @default(autoincrement())
  guildId Int
  name    String
  discordId              String        @unique
  guild   Guild @relation(fields: [guildId], references: [id])
}

model GuildCurrency {
  id      Int    @id @default(autoincrement())
  guildId Int
  name    String
  namePlural    String 
  iconSrc String
  guild   Guild @relation(fields: [guildId], references: [id])
}

model GuildRemovalReason {
  id      Int    @id @default(autoincrement())
  guildId Int
  title   String
  description String
  value   String
  guild   Guild @relation(fields: [guildId], references: [id])
}

model GuildRole {
  id      Int    @id @default(autoincrement())
  guildId Int
  name    String
  discordId              String        @unique
  guild   Guild @relation(fields: [guildId], references: [id])
}